\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the proposed Teacher-Student Self-supervised Neuro-Analytic model. Top row illustrates the NSER-IBVS (analytical) Teacher path, which uses YOLO for object segmentation and a mask splitter network to estimate object orientation relative to the drone camera. The bottom one represents the Student path, which learns by minimizing the MSE cost between its output drone commands ($\nu _x$, $\nu _y$, $\omega _z$) and the Teacher's output.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:teacher-student-math}{{1}{2}{Overview of the proposed Teacher-Student Self-supervised Neuro-Analytic model. Top row illustrates the NSER-IBVS (analytical) Teacher path, which uses YOLO for object segmentation and a mask splitter network to estimate object orientation relative to the drone camera. The bottom one represents the Student path, which learns by minimizing the MSE cost between its output drone commands ($\nu _x$, $\nu _y$, $\omega _z$) and the Teacher's output}{figure.caption.1}{}}
\newlabel{fig:teacher-student-math@cref}{{[figure][1][]1}{[1][1][]2}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}\hskip -1em.~Numerically Stable Efficient Reduced IBVS}{2}{subsection.3.1}\protected@file@percent }
\newlabel{sec:ibvs_implem}{{3.1}{2}{\texorpdfstring {\hskip -1em.~}{}Numerically Stable Efficient Reduced IBVS}{subsection.3.1}{}}
\newlabel{sec:ibvs_implem@cref}{{[subsection][1][3]3.1}{[1][2][]2}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Overview of the proposed Numerically Stable, Efficient, Reduced Image Based Visual Servoing (NSER-IBVS) architecture. The pipeline takes an RGB frame, generates segmentation, and feeds them as input to the Mask Splitter Network. From the original segmentation, bounding box coordinates are determined and used together with the divided front and back masks to rearrange coordinates positions. These coordinates serve as visual features for the analytical model to compute the velocity commands ($\nu _x$, $\nu _y$, $\omega _z$).}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:nser-ibvs}{{2}{3}{Overview of the proposed Numerically Stable, Efficient, Reduced Image Based Visual Servoing (NSER-IBVS) architecture. The pipeline takes an RGB frame, generates segmentation, and feeds them as input to the Mask Splitter Network. From the original segmentation, bounding box coordinates are determined and used together with the divided front and back masks to rearrange coordinates positions. These coordinates serve as visual features for the analytical model to compute the velocity commands ($\nu _x$, $\nu _y$, $\omega _z$)}{figure.caption.2}{}}
\newlabel{fig:nser-ibvs@cref}{{[figure][2][]2}{[1][2][]3}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Comparison of different bounding box approaches derived from segmentation results: (left) regular bounding box including parts that do not belong to the object, (middle) oriented bounding box that may vary in orientation between frames, and (right) oriented bounding box using a mask-splitting network to separate anterior and posterior vehicle components for improved ordering stability.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:bb-vs-obb-yolo-seg}{{3}{3}{Comparison of different bounding box approaches derived from segmentation results: (left) regular bounding box including parts that do not belong to the object, (middle) oriented bounding box that may vary in orientation between frames, and (right) oriented bounding box using a mask-splitting network to separate anterior and posterior vehicle components for improved ordering stability}{figure.caption.3}{}}
\newlabel{fig:bb-vs-obb-yolo-seg@cref}{{[figure][3][]3}{[1][2][]3}{}{}{}}
